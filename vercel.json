{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @voiceify/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    },
    "api/**/*.ts": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/voice-respond", "destination": "/api/voice/respond" },
    { "source": "/api/voice-transcribe", "destination": "/api/voice/transcribe" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
