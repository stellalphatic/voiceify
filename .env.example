# ───────────────────────────────────────────────
# Voiceify — Environment Variables
# ───────────────────────────────────────────────
#
# SECURITY MODEL
#   • SERVER ONLY (never prefix with VITE_) — read by apps/api, apps/worker,
#     Docker services, and legacy /api serverless handlers.
#   • CLIENT (VITE_*) — inlined into the browser bundle. Never put secrets here.
#
# Copy to .env and fill in real values. Never commit .env.
# ───────────────────────────────────────────────

# ── App URLs ──────────────────────────────────
APP_URL="http://localhost:5173"
WEB_ORIGIN="http://localhost:5173"
PORT="3001"

# ── Database (Postgres 16) ────────────────────
POSTGRES_USER="voiceify"
POSTGRES_PASSWORD="voiceify"
POSTGRES_DB="voiceify"
# Docker Compose maps Postgres to host port 5433 (avoids clash with local :5432)
DATABASE_URL="postgresql://voiceify:voiceify@localhost:5433/voiceify"

# ── Redis ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth (Better Auth) ────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3001"
# Comma-separated origins allowed for auth cookies / CSRF
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:5173,http://localhost:8080"

# ── AI providers (server-only) ────────────────
GEMINI_API_KEY="your-gemini-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"
ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"

# Optional model overrides
# GEMINI_MODEL="gemini-2.5-flash"
# GROQ_MODEL="llama-3.1-8b-instant"
# TTS_MODEL="eleven_flash_v2_5"
# STT_MODEL="scribe_v2"
# STT_REALTIME_MODEL="scribe_v2_realtime"

# Optional — require x-voiceify-key on /api/* routes
# VOICEIFY_API_KEY="your-server-api-key-here"

# ── Stripe (test mode) ────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_CREDITS_TOPUP="price_..."

# ── Docker / nginx public URL ─────────────────
# When serving via docker compose nginx on :8080
# APP_URL="http://localhost:8080"
# WEB_ORIGIN="http://localhost:8080"
# BETTER_AUTH_URL="http://localhost:8080"
# DATABASE_URL="postgresql://voiceify:voiceify@postgres:5432/voiceify"
# REDIS_URL="redis://redis:6379"

# ── Platform admin (super-admin portal) ───────
# Used by `pnpm db:seed:admin` — rotate in production
PLATFORM_ADMIN_EMAIL="admin@metapresence.co"
PLATFORM_ADMIN_PASSWORD="change-me-before-production"
PLATFORM_ADMIN_NAME="Platform Admin"
# When true, new signups skip pending approval (dev convenience)
AUTO_APPROVE_SIGNUPS="false"

# ── Optional / dev only ───────────────────────
# DISABLE_HMR="true"
