# ───────────────────────────────────────────────
# Voiceify — Environment Variables
# ───────────────────────────────────────────────
#
# SECURITY MODEL
#   • SERVER ONLY (never prefix with VITE_) — read by apps/api, apps/worker,
#     Docker services. Never put secrets in client code.
#   • CLIENT (VITE_*) — not used for provider keys in this monorepo.
#
# Copy to .env and fill in real values. Never commit .env.
# Full go-live guide: docs/deployment/GO_LIVE.md
# ───────────────────────────────────────────────

# ── App URLs (local Vite) ─────────────────────
APP_URL="http://localhost:5173"
WEB_ORIGIN="http://localhost:5173"
PORT="3001"

# ── Database (Postgres 16) ────────────────────
POSTGRES_USER="voiceify"
POSTGRES_PASSWORD="voiceify"
POSTGRES_DB="voiceify"
# Host-side tools use 5433 (compose maps 5433→5432). Inside Docker, compose overrides to postgres:5432.
DATABASE_URL="postgresql://voiceify:voiceify@localhost:5433/voiceify"

# ── Redis ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth (Better Auth) ────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3001"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:5173,http://localhost:8080"

# ── AI providers (REQUIRED for voice) ─────────
# See docs/deployment/GO_LIVE.md for where to create each key
GEMINI_API_KEY="your-gemini-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"
ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"

# Optional model overrides
# GEMINI_MODEL="gemini-2.5-flash"
# GROQ_MODEL="llama-3.1-8b-instant"
# TTS_MODEL="eleven_flash_v2_5"
# STT_MODEL="scribe_v2"
# STT_REALTIME_MODEL="scribe_v2_realtime"

# Optional — require x-voiceify-key on guarded voice routes
# VOICEIFY_API_KEY="your-server-api-key-here"

# ── Stripe (OPTIONAL — leave unset / disabled) ─
# Credits work without Stripe via admin portal or demo top-up.
STRIPE_ENABLED="false"
ALLOW_DEMO_TOPUP="true"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_CREDITS_TOPUP="price_..."

# ── Platform admin (super-admin portal) ───────
PLATFORM_ADMIN_EMAIL="admin@metapresence.co"
PLATFORM_ADMIN_PASSWORD="change-me-before-production"
PLATFORM_ADMIN_NAME="Platform Admin"
AUTO_APPROVE_SIGNUPS="false"

# ── Docker HTTP (:8080) ───────────────────────
# APP_URL="http://localhost:8080"
# WEB_ORIGIN="http://localhost:8080"
# BETTER_AUTH_URL="http://localhost:8080"
# BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:8080"

# ── Production subdomain (Caddy TLS profile) ──
# DOMAIN="voiceify.metapresence.co"
# ACME_EMAIL="admin@metapresence.co"
# APP_URL="https://voiceify.metapresence.co"
# WEB_ORIGIN="https://voiceify.metapresence.co"
# BETTER_AUTH_URL="https://voiceify.metapresence.co"
# BETTER_AUTH_TRUSTED_ORIGINS="https://voiceify.metapresence.co"
