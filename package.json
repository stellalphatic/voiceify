{
  "name": "voiceify",
  "private": true,
  "version": "3.2.0",
  "description": "Voiceify — Voice AI agents for support, sales, and operations.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @voiceify/web dev",
    "dev:api": "pnpm --filter @voiceify/api dev",
    "dev:worker": "pnpm --filter @voiceify/worker dev",
    "dev:legacy": "tsx server.ts",
    "build": "turbo build",
    "preview": "pnpm --filter @voiceify/web preview",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,md}\" \"packages/**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,md}\" \"packages/**/*.{ts,tsx,md}\"",
    "test": "turbo test",
    "db:generate": "pnpm --filter @voiceify/db generate",
    "db:migrate": "pnpm --filter @voiceify/db migrate",
    "db:seed": "pnpm --filter @voiceify/db seed",
    "db:seed:admin": "pnpm --filter @voiceify/auth seed:admin",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vercel/node": "^5.8.17",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "eslint": "^9.18.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "express": "^4.21.2",
    "globals": "^17.9.0",
    "prettier": "^3.4.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "turbo": "^2.3.3",
    "typescript": "~5.8.2",
    "vitest": "^3.0.4"
  },
  "packageManager": "pnpm@9.15.0"
}
