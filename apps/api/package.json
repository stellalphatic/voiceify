{
  "name": "@voiceify/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@voiceify/agents": "workspace:*",
    "@voiceify/auth": "workspace:*",
    "@voiceify/automations": "workspace:*",
    "@voiceify/db": "workspace:*",
    "@voiceify/shared": "workspace:*",
    "@voiceify/tools": "workspace:*",
    "@voiceify/usage": "workspace:*",
    "@voiceify/voice": "workspace:*",
    "dotenv": "^17.2.3",
    "hono": "^4.8.3",
    "ioredis": "^5.6.1",
    "tsx": "^4.21.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2",
    "vitest": "^3.0.4"
  }
}
